        "category_name": "一、 行前 14 天～1 個月（預訂與規劃）",
        "items": [
          {
            "id": "p001",
            "task": "交通車票/機票預訂",
            "details": "預訂台鐵新自強號等車票（建議下載台鐵e訂通），或確認國內航班；若需租車/機車，務必提早向當地租車行預約。",
            "completed": false
          },
          {
            "id": "p002",
            "task": "住宿安排",
            "details": "依行程動線（如市區、壽豐、瑞穗）分區入住，並確認是否有附設停車位及是否提供環保一次性備品。",
            "completed": false
          },
          {
            "id": "p003",
            "task": "景點與活動預約",
            "details": "線上預約賞鯨、立川漁場摸蜆或遊船等熱門體驗。出發前務必至太魯閣國家公園官網確認最新開放與封閉狀態。",
            "completed": false
          },
          {
            "id": "p004",
            "task": "路況與氣象查詢",
            "details": "開車族出發前需上「公路局幸福公路App」查詢蘇花路廊（台9線）與中橫最新路況。",
            "completed": false
          }
        ]
      },
      {
        "id": "packing_and_confirmation",
        "category_name": "二、 行前 3 天（打包與確認）",
        "items": [
          {
            "id": "k001",
            "task": "證件與票券",
            "details": "準備身分證、健保卡、駕照（汽車及機車），並備妥足夠現金（在地小吃、市場多僅收現金）。",
            "completed": false
          },
          {
            "id": "k002",
            "task": "衣物與防曬",
            "details": "準備輕便透氣衣物、防風薄外套、好走的步道布鞋或海邊涼鞋；若有玩水行程需帶泳衣褲與毛巾。",
            "completed": false
          },
          {
            "id": "k003",
            "task": "3C與隨身用品",
            "details": "攜帶手機、行動電源、充電線、暈車藥（山路海線多彎道）、防蚊液、防曬乳及個人常備藥品。",
            "completed": false
          }
        ]
      },
      {
        "id": "on_arrival",
        "category_name": "三、 抵達花蓮後（落地檢核）",
        "items": [
          {
            "id": "a001",
            "task": "交通與導航設定",
            "details": "檢查租賃或自備車輛的油量/電量，建議下載離線地圖以防山區或海線（台11線）訊號不佳。",
            "completed": false
          },
          {
            "id": "a002",
            "task": "行程踩點順序檢查",
            "details": "依北花蓮、中花蓮、南花蓮分區順遊，避免折返車程。確認東大門夜市、七星潭等必訪清單順序。",
            "completed": false
          }
        ]
      }
